# Nombre de la base de datos usada por WordPress
MYSQL_DATABASE=wordpress_db

# Usuario normal de MySQL
MYSQL_USER=wordpress_user

# Contraseña de ejemplo para el usuario de MySQL
MYSQL_PASSWORD=change_me

# Contraseña de ejemplo para el usuario root de MySQL
MYSQL_ROOT_PASSWORD=change_root_password

# Puerto del equipo anfitrión que expondrá WordPress
WORDPRESS_PORT=8082
